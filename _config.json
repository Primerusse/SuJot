{
  // ══ 速笺 SuJot · 项目级配置 ══════════════════════════════════════════
  // 所有能调的参数都集中在这里。每一项都可以删掉 —— 删掉就用代码里的默认值，
  // 整个文件删了也能跑。
  // 优先级：环境变量（SUJIAN_*）> 本文件 > 代码里的默认值。
  // 改完要重启服务才生效（服务器上：sudo systemctl restart sujian）。
  // 文件名以下划线开头：它不是运行数据，改它、删它都不会碰到你的笔记。
  // 想留第二套配置，就另存一份（比如 _config.prod.json），再用环境变量
  // SUJIAN_CONFIG 指过去。

  // ── 服务 ───────────────────────────────────────────────────────────
  "port": 8013,                 // 监听端口。改了记得同步 nginx 的反代配置
  "host": "127.0.0.1",          // 监听地址。建议保持只绑本机，外网交给 nginx + HTTPS
  "open_browser": true,         // 本机启动时自动打开浏览器（只在有终端时做，systemd 下跳过）
  "cookie_name": "sujian",      // 登录 Cookie 的名字
  "session_days": 30,           // 勾了「记住我」之后，登录状态保持多少天

  // ── 目录 ───────────────────────────────────────────────────────────
  "data_dir": "",               // 数据目录：笔记、历史版本、回收站、账号、站点配置都在这里。
                                // 留空＝自动（服务器上 /srv/sujian，自己的电脑上 ./data）
  "static_dir": "",             // 前端静态文件目录。留空＝自动（数据目录下的 static/，或本目录的 static/）
  "seed_dir": "",               // 首次部署铺样板笔记的来源。留空＝本目录的 assets/
  "pass_file": "",              // 兼容用的旧明文口令文件（读到就建号并删掉它）。不用就留空

  // ── 账号与安全 ─────────────────────────────────────────────────────
  "default_user": "admin",      // 初始账号名（初始口令固定是 admin，不写在这里；首次登录强制改）
  "login_attempts": 5,          // 密码连续输错几次开始临时锁定
  "login_lock_seconds": 30,     // 锁定多少秒

  // ── 文件大小与流量 ─────────────────────────────────────────────────
  "max_body_mb": 8,             // 单次请求体上限（MB）。用 nginx 时那边的 client_max_body_size 要 ≥ 它
  "upload_max_mb": 12,          // 单张正文插图的上限（MB）
  "logo_max_mb": 4,             // 站点图标上限（MB）
  "avatar_max_mb": 2,           // 头像上限（MB）
  "gzip_min_bytes": 1024,       // 文本类响应超过这么多字节才压缩（不挂 nginx 时也能省流量）
  "cache_days": 365,            // 带 ?v= 的静态资源让浏览器缓存多少天（发版时 ?v= 会自动换号）

  // ── 笔记与历史 ─────────────────────────────────────────────────────
  "keep_history": 30,           // 每篇笔记保留多少个历史版本，超出的自动清理
  "history_list_max": 30,       // 「历史版本」面板最多列多少条

  // ── 站点初值 ───────────────────────────────────────────────────────
  // 只在站点配置还没建立时生效；之后以页面里「设置」改的为准（存在 data/site.json）
  "site": {
    "brand": "速笺",            // 站名：左导航栏与登录页上显示的名字
    "tabTitle": "",             // 浏览器标签上的字；留空就用站名
    "logoText": ""              // 没有上传图标时用的文字图标
  }
}
