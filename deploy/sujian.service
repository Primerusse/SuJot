[Unit]
Description=速笺 SuJot 笔记服务
After=network.target

[Service]
Type=simple
# 以专用非 root 用户运行：install-service.sh 会建好这个用户并交接数据目录属主
User=sujian
Group=sujian
WorkingDirectory=/srv/sujian

# 数据目录（笔记 / 历史版本 / 回收站 / 账号 / 站点配置都在这里）
Environment=SUJIAN_BASE=/srv/sujian
Environment=SUJIAN_PORT=8013

ExecStart=/usr/bin/python3 /srv/sujian/server.py
Restart=always
RestartSec=2

# ── 沙箱（v0.2.1 加固）──────────────────────────────────────
# 一个人用的服务，把不需要的权限全收起来。
# 注意：systemd 的 unit 文件不支持行尾注释，注释必须独占一行，否则会被当成值的一部分。
MemoryMax=180M
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true

# / 挂成只读，只有 ReadWritePaths 指定的数据目录可写
ProtectSystem=strict
ReadWritePaths=/srv/sujian

# 代码或数据若放在 /home、/root 下，这行要改成 ProtectHome=read-only，
# 否则服务读不到自己的代码（install-service.sh 会自动判断）
ProtectHome=true

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true

# 只监听 127.0.0.1 的非特权端口，不需要任何 capability
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
